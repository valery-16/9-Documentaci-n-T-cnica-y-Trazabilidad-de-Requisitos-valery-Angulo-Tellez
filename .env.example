# ============================================================
# puesto-chance-api — Variables de entorno de ejemplo
# Copie este archivo como `.env` y ajuste los valores:
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# ============================================================

# --- Servidor ---
# Puerto HTTP donde escucha la API
PORT=3000

# --- Autenticación (JWT) ---
# Secreto para firmar los tokens. ¡Debe cambiarlo en producción
# y nunca subir el .env real al repositorio!
JWT_SECRET=mi-secreto-super-seguro-de-desarrollo
# Tiempo de vida del token (formatos de jsonwebtoken: 8h, 30m, 7d...)
JWT_EXPIRES_IN=8h

# --- Regionalización ---
# Zona horaria usada para fechas de venta, cierres de caja y sorteos
ZONA_HORARIA=America/Bogota

# --- Reglas de negocio: tiquetes ---
# Minutos posteriores a la venta durante los cuales el propio
# vendedor (o un ADMIN) puede anular un tiquete
MINUTOS_ANULACION=10
# Minutos antes de la fecha del sorteo en que se cierran las ventas
MINUTOS_CIERRE_VENTAS=15

# --- Reglas de negocio: Chance ---
# Valor mínimo y máximo por apuesta (COP). Deben ser múltiplos de 100
APUESTA_MIN_CHANCE=500
APUESTA_MAX_CHANCE=50000

# --- Reglas de negocio: Baloto ---
# Valor fijo de cada jugada de Baloto (COP)
VALOR_BALOTO=5700

# --- Reglas de negocio: premios ---
# Días que tiene el ganador para reclamar su premio antes de caducar
DIAS_CADUCIDAD_PREMIO=365

# --- Opcional ---
# NODE_ENV=development   # 'test' desactiva el log morgan en pruebas
